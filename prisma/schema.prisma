generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  TRIAL
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String?
  image          String?
  passwordHash   String?
  emailVerified  DateTime?
  role           UserRole            @default(USER)
  bannedUntil    DateTime?
  banReason      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  accounts       Account[]
  sessions       Session[]
  goals          Goal[]
  projects       Project[]
  projectNotes   ProjectNote[]
  taskColumns        TaskColumn[]
  tasks              Task[]
  weekLocalTasks     WeekLocalTask[]
  weekTaskPlacements WeekTaskPlacement[]
  journalEntries JournalEntry[]
  journalTags    JournalTag[]
  habits         Habit[]
  challenges               Challenge[]
  challengeRewards         ChallengeReward[]
  challengeTriggers        ChallengeTrigger[]
  challengeHabits          ChallengeHabit[]
  challengeRestrictions    ChallengeRestriction[]
  challengeCustomDebts     ChallengeCustomDebt[]
  challengeXpActivities    ChallengeXpActivity[]
  challengeActivityLogs    ChallengeActivityLog[]
  challengeXpTransactions  ChallengeXpTransaction[]
  challengeRewardPurchases ChallengeRewardPurchase[]
  challengeDays            ChallengeDay[]
  challengeDebtItems       ChallengeDebtItem[]
  challengePauses          ChallengePause[]
  financeAccounts FinanceAccount[]
  financeTransactions FinanceTransaction[]
  financeTransfers FinanceTransfer[]
  financePurposeChanges FinanceAccountPurposeChange[]
  financeCapitalGoals FinanceCapitalGoal[]
  tables         CustomTable[]
  dailyTasks     DailyTask[]
  subscription   Subscription?
  featureGrants  UserFeatureGrant[]
  energyCheckIns EnergyCheckIn[]
  activityEvents ActivityEvent[]
  plannerLayout  PlannerLayout?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  tokenHash    String   @unique
  locale       String   @default("ru")
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  plan      String             @default("free")
  status    SubscriptionStatus @default(TRIAL)
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model DisplayModeFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model ItemType {
  key       String
  section   String
  label     String   @default("")
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([section, key])
}

model UserFeatureGrant {
  id          String    @id @default(cuid())
  userId      String
  featureKey  String
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([userId])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @default("")
  progress    Int      @default(0)
  deadline    DateTime
  category    String
  type        String
  priority    String   @default("medium")
  kanbanOrder Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  projects    Project[]

  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String    @default("")
  status      String    @default("active")
  priority    String    @default("medium")
  startDate   DateTime?
  plannedEnd  DateTime?
  color       String?
  icon        String?
  goalId      String?
  nextAction  String    @default("")
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks       Task[]
  notes       ProjectNote[]

  @@index([userId])
  @@index([goalId])
}

model ProjectNote {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

model TaskColumn {
  id         String    @id @default(cuid())
  userId     String
  title      String
  kind       String    @default("default")
  legacyKey  String?
  dateFrom   DateTime?
  dateTo     DateTime?
  sortOrder  Int       @default(0)
  isHidden   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
  localTasks     WeekLocalTask[]
  taskPlacements WeekTaskPlacement[]

  @@unique([userId, legacyKey])
  @@index([userId])
  @@index([userId, kind])
}

model Task {
  id          String    @id @default(cuid())
  userId           String
  goalId           String?
  projectId        String?
  columnId         String?
  title            String
  description      String    @default("")
  completed        Boolean   @default(false)
  priority         String    @default("medium")
  type             String    @default("backlog")
  kanbanOrder      Int       @default(0)
  stepOrder        Int       @default(0)
  estimatedMinutes Int?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  deadline         DateTime?
  overdue          Boolean   @default(false)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project          Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  column           TaskColumn?         @relation(fields: [columnId], references: [id], onDelete: SetNull)
  weekPlacements   WeekTaskPlacement[]

  @@index([userId])
  @@index([goalId])
  @@index([projectId])
  @@index([columnId])
}

model WeekLocalTask {
  id           String    @id @default(cuid())
  userId       String
  weekColumnId String
  title        String
  description  String    @default("")
  plannedDate  DateTime?
  priority     String    @default("medium")
  status       String    @default("todo")
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekColumn   TaskColumn @relation(fields: [weekColumnId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([weekColumnId])
  @@index([weekColumnId, plannedDate])
}

model WeekTaskPlacement {
  id           String    @id @default(cuid())
  userId       String
  taskId       String
  weekColumnId String
  plannedDate  DateTime?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  weekColumn   TaskColumn @relation(fields: [weekColumnId], references: [id], onDelete: Cascade)

  @@unique([taskId, weekColumnId])
  @@index([userId])
  @@index([weekColumnId])
}

model PlannerLayout {
  userId                 String @id
  goalsKanbanColumnOrder Json   @default("[]")
  tasksKanbanColumnOrder Json   @default("[]")
  user                   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReflectionQuestion {
  period    String
  sortOrder Int
  textRu    String   @db.Text
  textEn    String   @db.Text
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([period, sortOrder])
}

model JournalTag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model JournalEntry {
  id                String   @id @default(cuid())
  userId            String
  title             String
  content           String   @db.Text
  date              DateTime @db.Date
  entryType         String   @default("free")
  reflectionPeriod  String?
  reflectionAnswers Json?
  tagIds            Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model Habit {
  id            String   @id @default(cuid())
  userId        String
  name          String
  frequency     String
  streak        Int      @default(0)
  completedDays Json     @default("[]")
  trackingType  String   @default("check")
  targetCount   Int?
  dayCounts     Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeHabits ChallengeHabit[]

  @@index([userId])
}

enum FinanceAccountPurpose {
  REGULAR
  CAPITAL
}

model FinanceAccount {
  id             String                     @id @default(cuid())
  userId         String
  name           String
  currency       String                     @default("BYN")
  initialBalance Decimal                    @default(0) @db.Decimal(14, 2)
  isDefault      Boolean                    @default(false)
  purpose        FinanceAccountPurpose      @default(REGULAR)
  icon           String?
  archivedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   FinanceTransaction[]
  purposeChanges FinanceAccountPurposeChange[]
  transfersFrom  FinanceTransfer[]          @relation("TransferFromAccount")
  transfersTo    FinanceTransfer[]          @relation("TransferToAccount")

  @@index([userId])
  @@index([userId, purpose])
}

model FinanceTransfer {
  id             String               @id @default(cuid())
  userId         String
  idempotencyKey String
  fromAccountId  String
  toAccountId    String
  debitAmount    Decimal              @db.Decimal(14, 2)
  creditAmount   Decimal              @db.Decimal(14, 2)
  exchangeRate   Decimal?             @db.Decimal(18, 8)
  feeAmount      Decimal              @default(0) @db.Decimal(14, 2)
  date           DateTime             @db.Date
  comment        String               @default("")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount    FinanceAccount       @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount      FinanceAccount       @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  legs           FinanceTransaction[]

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
}

model FinanceTransaction {
  id                    String           @id @default(cuid())
  userId                String
  accountId             String
  type                  String
  amount                Decimal          @db.Decimal(14, 2)
  category              String
  description           String           @default("")
  date                  DateTime         @db.Date
  capitalFlow           String?
  capitalKind           String?
  transferId            String?
  transferLeg           String?
  source                String?
  expenseCategory       String?
  idempotencyKey        String?
  counterpartyAccountId String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transfer              FinanceTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([accountId])
  @@index([userId, date])
  @@index([transferId])
}

model FinanceAccountPurposeChange {
  id              String                 @id @default(cuid())
  userId          String
  accountId       String
  fromPurpose     FinanceAccountPurpose?
  toPurpose       FinanceAccountPurpose
  balanceAtChange Decimal                @db.Decimal(14, 2)
  effectiveDate   DateTime               @db.Date
  createdAt       DateTime               @default(now())
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         FinanceAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, accountId, effectiveDate])
}

model FinanceCapitalGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  goalType      String
  targetAmount  Decimal   @db.Decimal(14, 2)
  currency      String
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  description   String    @default("")
  archivedAt    DateTime?
  celebratedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExchangeRateHistory {
  id        String   @id @default(cuid())
  rateDate  DateTime @db.Date
  currency  String
  scale     Int
  rate      Decimal  @db.Decimal(18, 8)
  source    String
  createdAt DateTime @default(now())

  @@unique([rateDate, currency])
  @@index([currency, rateDate])
}

model CustomTable {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  columns   Json
  rows      Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyTask {
  id     String @id @default(cuid())
  userId String
  date   String
  taskId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, taskId])
  @@index([userId, date])
}

model EnergyTestVersion {
  id        String   @id
  version   Int      @unique
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  questions EnergyTestVersionQuestion[]
  checkIns  EnergyCheckIn[]
}

model EnergyQuestion {
  id             String   @id
  key            String
  version        Int      @default(1)
  textRu         String   @db.Text
  textEn         String   @db.Text
  minValue       Int      @default(0)
  maxValue       Int      @default(10)
  minLabelRu     String
  minLabelEn     String
  midLabelRu     String   @default("")
  midLabelEn     String   @default("")
  maxLabelRu     String
  maxLabelEn     String
  reverseScoring Boolean  @default(false)
  defaultWeight  Float    @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  testVersions   EnergyTestVersionQuestion[]
  answers        EnergyCheckInAnswer[]

  @@unique([key, version])
  @@index([key])
}

model EnergyTestVersionQuestion {
  id            String            @id @default(cuid())
  testVersionId String
  questionId    String
  sortOrder     Int
  weight        Float             @default(1)
  testVersion   EnergyTestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)
  question      EnergyQuestion    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([testVersionId, questionId])
  @@unique([testVersionId, sortOrder])
  @@index([testVersionId])
}

model EnergyCheckIn {
  id            String                 @id @default(cuid())
  userId        String
  testVersionId String
  score         Float
  createdAt     DateTime               @default(now())
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  testVersion   EnergyTestVersion      @relation(fields: [testVersionId], references: [id], onDelete: Restrict)
  answers       EnergyCheckInAnswer[]

  @@index([userId, createdAt])
  @@index([testVersionId])
}

model ActivityEvent {
  id             String   @id @default(cuid())
  userId         String
  type           String
  entityType     String
  entityId       String?
  title          String   @default("")
  metadata       Json     @default("{}")
  idempotencyKey String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([userId, entityType])
}

model EnergyCheckInAnswer {
  id              String          @id @default(cuid())
  checkInId       String
  questionId      String
  questionVersion Int
  rawValue        Int
  effectiveValue  Float
  weight          Float
  checkIn         EnergyCheckIn   @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  question        EnergyQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([checkInId])
  @@index([questionId])
}

enum ChallengeStatus {
  active
  paused
  completed
  archived
}

enum ChallengeDayStatus {
  pending
  successful
  failed
  skipped
}

enum ChallengeRestrictionKind {
  core_behavior
  custom
}

enum ChallengeDebtSource {
  habit
  restriction
  custom
}

enum ChallengeDebtState {
  pending
  satisfied
  missed
  not_applicable
  bypassed
}

enum ChallengeXpUnit {
  repetitions
  minutes
  kilometers
  completion
}

enum ChallengeXpReason {
  activity_grant
  reward_purchase
  streak_reset
  activity_reversal
  adjustment
}

model Challenge {
  id               String          @id @default(cuid())
  userId           String
  title            String
  description      String          @default("")
  unwantedBehavior String
  behaviorPreset   String?
  yearsStruggling  Int?
  importance       Int
  targetDays          Int
  startsAt            DateTime
  abstinenceStartedAt DateTime
  status              ChallengeStatus @default(active)
  currentStreak    Int             @default(0)
  bestStreak       Int             @default(0)
  timezone         String
  xpBalance        Int             @default(0)
  xpEarnedTotal    Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewards          ChallengeReward[]
  triggers         ChallengeTrigger[]
  habits           ChallengeHabit[]
  restrictions     ChallengeRestriction[]
  customDebts      ChallengeCustomDebt[]
  xpActivities     ChallengeXpActivity[]
  activityLogs     ChallengeActivityLog[]
  xpTransactions   ChallengeXpTransaction[]
  purchases        ChallengeRewardPurchase[]
  days             ChallengeDay[]
  debtItems        ChallengeDebtItem[]
  pauses           ChallengePause[]

  // One active challenge per user is enforced by partial unique index
  // Challenge_userId_active_key in the ascent migration. Prisma 6.12 cannot declare it.
  @@index([userId])
  @@index([userId, status])
}

model ChallengeReward {
  id           String   @id @default(cuid())
  userId       String
  challengeId  String
  title        String
  description  String   @default("")
  icon         String?
  xpCost       Int
  active       Boolean  @default(true)
  available    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  restrictions ChallengeRestriction[]
  purchases    ChallengeRewardPurchase[]

  @@index([userId])
  @@index([challengeId, sortOrder])
}

model ChallengeTrigger {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  title       String
  description String    @default("")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([challengeId, sortOrder])
}

model ChallengeHabit {
  id             String    @id @default(cuid())
  userId         String
  challengeId    String
  habitId        String
  required       Boolean   @default(true)
  sortOrder      Int       @default(0)
  completionRule String    @default("as_habit")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  habit          Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([challengeId, habitId])
  @@index([userId])
  @@index([habitId])
}

model ChallengeRestriction {
  id                        String                   @id @default(cuid())
  userId                    String
  challengeId               String
  title                     String
  description               String                   @default("")
  kind                      ChallengeRestrictionKind
  unlockAfterSuccessfulDays Int                      @default(0)
  rewardId                  String?
  required                  Boolean                  @default(true)
  bypassable                Boolean                  @default(false)
  active                    Boolean                  @default(true)
  sortOrder                 Int                      @default(0)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge                 Challenge                @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reward                    ChallengeReward?         @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  purchases                 ChallengeRewardPurchase[]

  @@index([userId])
  @@index([challengeId, sortOrder])
  @@index([rewardId])
}

model ChallengeCustomDebt {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  title       String
  description String    @default("")
  required    Boolean   @default(true)
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([challengeId, sortOrder])
}

model ChallengeXpActivity {
  id               String          @id @default(cuid())
  userId           String
  challengeId      String
  title            String
  actionType       String
  unit             ChallengeXpUnit
  xpPerGrant       Int
  quantityPerGrant Decimal         @db.Decimal(12, 3)
  minQuantity      Decimal         @db.Decimal(12, 3)
  active           Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge        Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  logs             ChallengeActivityLog[]

  @@index([userId])
  @@index([challengeId, sortOrder])
}

model ChallengeActivityLog {
  id             String              @id @default(cuid())
  userId         String
  challengeId    String
  activityId     String
  localDate      String
  quantity       Decimal             @db.Decimal(12, 3)
  xpGranted      Int
  idempotencyKey String
  reversedAt     DateTime?
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge      Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  activity       ChallengeXpActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  transactions   ChallengeXpTransaction[]

  @@unique([userId, idempotencyKey])
  @@index([challengeId, localDate])
  @@index([activityId])
}

model ChallengeRewardPurchase {
  id               String    @id @default(cuid())
  userId           String
  challengeId      String
  rewardId         String
  restrictionId    String?
  xpSpent          Int
  grantsBypass     Boolean   @default(false)
  permissionUsed   Boolean   @default(false)
  permissionUsedAt DateTime?
  usedOnLocalDate  String?
  idempotencyKey   String
  purchasedAt      DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge        Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reward           ChallengeReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  restriction      ChallengeRestriction? @relation(fields: [restrictionId], references: [id], onDelete: Restrict)
  transaction      ChallengeXpTransaction?

  @@unique([userId, idempotencyKey])
  @@index([challengeId, purchasedAt])
  @@index([rewardId])
  @@index([restrictionId])
}

model ChallengeXpTransaction {
  id               String            @id @default(cuid())
  userId           String
  challengeId      String
  amount           Int
  lifetimeDelta    Int               @default(0)
  reason           ChallengeXpReason
  balanceAfter     Int
  earnedTotalAfter Int
  idempotencyKey   String
  localDate        String?
  sourceId         String?
  activityLogId    String?
  purchaseId       String?           @unique
  note             String            @default("")
  createdAt        DateTime          @default(now())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge        Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  activityLog      ChallengeActivityLog? @relation(fields: [activityLogId], references: [id], onDelete: Restrict)
  purchase         ChallengeRewardPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([challengeId, createdAt])
  @@index([activityLogId])
}

model ChallengeDay {
  id              String             @id @default(cuid())
  userId          String
  challengeId     String
  localDate       String
  status          ChallengeDayStatus @default(pending)
  obligationsMet  Boolean            @default(false)
  debtClosed      Boolean            @default(false)
  failureReason   String?
  settledAt       DateTime?
  streakAfter     Int?
  bestStreakAfter Int?
  xpBalanceAfter  Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge       Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, localDate])
  @@index([userId, localDate])
}

model ChallengeDebtItem {
  id              String              @id @default(cuid())
  userId          String
  challengeId     String
  localDate       String
  source          ChallengeDebtSource
  sourceId        String
  title           String
  required        Boolean
  state           ChallengeDebtState
  confirmedByUser Boolean             @default(false)
  confirmedAt     DateTime?
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge       Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, localDate, source, sourceId])
  @@index([userId, localDate])
}

model ChallengePause {
  id                 String    @id @default(cuid())
  userId             String
  challengeId        String
  startedAt          DateTime
  startedOnLocalDate String
  endedAt            DateTime?
  endedOnLocalDate   String?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge          Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  // At most one open pause per challenge: partial unique index ChallengePause_one_open_key.
  @@index([userId])
  @@index([challengeId, startedAt])
}
